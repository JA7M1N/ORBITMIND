# OrbitalMind — Environment Configuration
# Copy this file to .env and fill in your values.
# pydantic-settings auto-reads .env from the working directory.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy 2.0 async DSN — use postgresql+asyncpg:// driver.
# If you write postgresql:// it is automatically converted (see config.py).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/orbitalmind

# ── Demo mode ─────────────────────────────────────────────────────────────────
# True  = reads from pre-computed JSON on disk (< 200 ms, no GPU needed)
# False = runs live Sentinel-1 SAR inference (FloodModule only in Phase 1)
DEMO_MODE=True

# ── Ollama / LLM narration ────────────────────────────────────────────────────
# Local Ollama server URL and model tag.
# VRAM WARNING: never run Ollama while FloodModule inference is active.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Optional overrides (defaults are fine for local dev) ─────────────────────
# API_VERSION=2.0.0
# SUPPORTED_DISASTERS=["flood","wildfire","landslide","cyclone","earthquake"]
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
